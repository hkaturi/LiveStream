# Copy this file to .env locally and fill in values through your secret manager.
# Never commit or share the populated .env file.

AGORA_APP_ID=replace-with-agora-app-id
AGORA_APP_CERTIFICATE=replace-with-agora-app-certificate
CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
DATABASE_URL=replace-with-database-url

# Runtime configuration
SESSION_SECRET=replace-with-session-secret
CLERK_PROXY_URL=
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_REPL_ID=
PORT=3000
BASE_PATH=/